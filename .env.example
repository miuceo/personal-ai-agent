# Get these from https://my.telegram.org/apps (login with your phone number)
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Your own phone number, international format, e.g. +998901234567
PHONE_NUMBER=+998xxxxxxxxx

# OpenRouter API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# Free-tier model on OpenRouter, e.g. google/gemini-2.0-flash-exp:free
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Minutes to stay silent in a chat after the owner replies manually
OWNER_PAUSE_MINUTES=10

# How many recent raw messages to keep in short-term context (per chat)
SHORT_HISTORY_LIMIT=6

OWNER_ID=simple
GROQ_API_KEY=simple
DATABASE_URL=simple
