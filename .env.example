# --- Telegram (your own account, not a bot token) ---
# Get these from https://my.telegram.org/apps (login with your phone number)
API_ID=your_api_id_here
API_HASH=your_api_hash_here
PHONE_NUMBER=+998xxxxxxxxx

# Your own numeric Telegram user ID (find it via @IDBot / @userinfobot).
# Messages FROM this ID are treated as the owner, everyone else as a contact.
OWNER_ID=123456789

# Leave EMPTY for the very first run of generate_session.py.
# After running it once, paste the printed string here (and in Kuberns).
TELEGRAM_SESSION=

# --- Database (Neon PostgreSQL) ---
# Connection string from your Neon dashboard, e.g.:
# postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- LLM providers ---
# Text replies (no image) -> Groq, fast + generous free tier.
# Voice transcription -> Groq Whisper, tuned for Uzbek.
# Image/vision understanding -> OpenRouter (Groq's free chat models don't
# accept images).
#
# Every list below is an ORDERED FALLBACK CHAIN (comma-separated, no spaces
# around commas needed). If the first model fails or is rate-limited, the
# next one is tried automatically — the bot only goes to its last-resort
# generic reply if EVERY model in the relevant chain fails at once.

# --- Groq (text generation + voice transcription) ---
GROQ_API_KEY=your_groq_key_here

# Chat models for text-only replies. gpt-oss-120b = quality, gpt-oss-20b =
# fast backup. (llama-3.3-70b-versatile was retired by Groq on 2026-08-16 —
# do not use it.) Check https://console.groq.com/docs/models for the current list.
GROQ_TEXT_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# Whisper models for voice messages, tried in order.
GROQ_STT_MODELS=whisper-large-v3-turbo,whisper-large-v3
# ISO-639-1 code passed to Whisper so it doesn't have to auto-detect the
# language — improves accuracy/speed and avoids mis-detection on short clips.
STT_LANGUAGE=uz

# --- OpenRouter (vision / image understanding, + last-resort text fallback) ---
OPENROUTER_API_KEY=your_openrouter_key_here

# Vision chain for photo messages. Free vision model IDs rotate — check
# https://openrouter.ai/collections/free-models before relying on a specific
# one. The last entry, openrouter/free, is an auto-router that picks
# whatever free model currently supports images, so the chain keeps working
# even if a named model gets delisted.
OPENROUTER_VISION_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,openrouter/free

# Used ONLY if every Groq text model above fails (e.g. Groq itself is down).
OPENROUTER_TEXT_FALLBACK_MODEL=z-ai/glm-5.2:free

# --- Behavior tuning ---
OWNER_PAUSE_MINUTES=10
SHORT_HISTORY_LIMIT=6
# How long the bot waits before answering, giving the owner a chance to
# reply personally first.
INITIAL_REPLY_DELAY_SECONDS=60

# Flood protection: max auto-replies per rolling 1-hour window, per chat
# and across all chats combined. Protects the account from being flagged.
MAX_REPLIES_PER_HOUR_PER_CHAT=20
MAX_REPLIES_PER_HOUR_GLOBAL=60
